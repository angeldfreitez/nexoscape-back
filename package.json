{
  "name": "nexo-back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "prettier --write src scripts test api *.json *.ts",
    "format:check": "prettier --check src scripts test api *.json *.ts",
    "migrate": "pnpm build && node dist/scripts/migrate.js",
    "user:create": "pnpm build && node dist/scripts/create-initial-user.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start:watch": "node --watch dist/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/throttler": "6.7.1",
    "typeorm": "1.1.2",
    "pg": "8.23.1",
    "argon2": "0.45.2",
    "express-session": "1.19.0",
    "connect-pg-simple": "10.0.0",
    "zod": "4.6.7",
    "helmet": "8.3.0",
    "csrf-sync": "4.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@nestjs/cli": "12.0.12",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "supertest": "7.3.2",
    "prettier": "3.9.10",
    "@swc/core": "1.16.22",
    "unplugin-swc": "2.0.0",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1"
  }
}
